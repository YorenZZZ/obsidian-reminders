    "obsidian",
    "reminders",
    "macos",
    "tasks",
    "menubar"
  ],
  "homepage": "https://github.com/YorenZZZ/obsidian-reminders#readme",
  "bugs": "https://github.com/YorenZZZ/obsidian-reminders/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YorenZZZ/obsidian-reminders.git"
  },
  "license": "MIT",
  "author": "YorenZZZ",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=16"
  },
  "bin": {
    "obsidian-reminders": "bin/obsidian-reminders.js"
  },
  "files": [
    "bin/"
  ],
  "scripts": {
    "postinstall": "node bin/obsidian-reminders.js postinstall",
    "prepack": "scripts/npm-prepack.sh"
  }
